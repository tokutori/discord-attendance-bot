# Copy to the repository root as .env.view for Docker Compose.
# Use a DIFFERENT Discord Application. Never put DISCORD_TOKEN here.
DISCORD_VIEW_TOKEN=replace_with_view_bot_token
DISCORD_CORE_APPLICATION_ID=123456789012345678
DISCORD_GUILD_ID=123456789012345678
DATABASE_URL=sqlite:///data/attendance.db
# Match the recording process policies.
ATTENDANCE_TIMEZONE=Asia/Tokyo
ATTENDANCE_AUTO_END_TIME=21:00
ATTENDANCE_STATUS_MODE=disabled
# ATTENDANCE_STATUS_CHANNEL_ID=123456789012345678
ATTENDANCE_STATUS_REFRESH_SECONDS=600
# ATTENDANCE_PDF_FONT_PATH=/path/to/JapaneseFont.ttf
