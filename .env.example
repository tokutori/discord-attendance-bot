# Discord Developer Portal で取得した Bot token
DISCORD_TOKEN=replace_me

# 1プロセスで運用するDiscordサーバーID
DISCORD_GUILD_ID=123456789012345678

# 永続化するSQLite database URL
DATABASE_URL=sqlite://attendance.db

# disabled: ActivityとTopic更新を無効化
# count: 人数だけ表示
# names: 人数とDiscord表示名を表示
ATTENDANCE_STATUS_MODE=count

# STATUS_MODEがcountまたはnamesの場合だけ必須
ATTENDANCE_STATUS_CHANNEL_ID=111111111111111111

# IANA timezone、自動終了時刻（disabledで自動終了なし）、Topic更新間隔
ATTENDANCE_TIMEZONE=Asia/Tokyo
ATTENDANCE_AUTO_END_TIME=21:00
ATTENDANCE_STATUS_REFRESH_SECONDS=600

# fullを推奨。normalは電源断時に直近のcommitを失う可能性がある
ATTENDANCE_SQLITE_SYNCHRONOUS=full

# ログレベル
RUST_LOG=discord_attendance_bot=info,poise=info,serenity=info

# PDF用日本語フォント（省略時はOSの既定候補を検索）
# ATTENDANCE_PDF_FONT_PATH=C:\Windows\Fonts\NotoSansJP-VF.ttf

# 既存のtest/release分離運用を継続する場合は、起動引数にtestまたはreleaseを付け、
# 上のDISCORD_GUILD_ID・DATABASE_URL・ATTENDANCE_STATUS_CHANNEL_IDの代わりに
# 対応する変数を使用する。
# DISCORD_TEST_GUILD_ID=123456789012345678
# DISCORD_RELEASE_GUILD_ID=987654321098765432
# DATABASE_URL_TEST=sqlite://attendance-test.db
# DATABASE_URL_RELEASE=sqlite://attendance-release.db
# ATTENDANCE_STATUS_CHANNEL_ID_TEST=111111111111111111
# ATTENDANCE_STATUS_CHANNEL_ID_RELEASE=222222222222222222
